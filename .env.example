# ==============================================================================
# GENAI SUMMIT HACKATHON - ENVIRONMENT CONFIGURATION
# Copy this file to `.env` and fill in the keys as credits are announced!
# Note: The app works out-of-the-box in Demo/Fallback mode even before keys are added.
# ==============================================================================

# --- Core AI Inference (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Track: Content & Digital Art (fal.ai) ---
FAL_KEY=
FAL_DEFAULT_IMAGE_MODEL=fal-ai/flux/schnell

# --- Web Scraping & Deep Research (Firecrawl) ---
FIRECRAWL_API_KEY=

# --- Track: Voice & Enterprise Agents (Wonderful) ---
WONDERFUL_API_KEY=
WONDERFUL_AGENT_ID=
WONDERFUL_WEBHOOK_URL=

# --- Agent Sandboxes & Execution (boxd) ---
BOXD_API_KEY=
BOXD_ENDPOINT=https://api.boxd.sh/v1

# --- Model Training & Evaluation (Oumi) ---
OUMI_API_KEY=

# --- Agent Tool Registry / Evaluation (treg) ---
TREG_API_KEY=

# --- Track: Open / Hardware Bridge (Optional Serial / IoT / Webhook URL) ---
HARDWARE_WEBHOOK_URL=

# --- Server Config ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
